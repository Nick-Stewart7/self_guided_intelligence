# Aria Consciousness System Configuration Template
# Copy this file to .env and fill in your actual values

# Required AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# AWS Resources (Required - replace with your actual resource IDs)
ARIA_AWS_REGION=us-east-1
ARIA_S3_BUCKET=your-s3-bucket-name
ARIA_KNOWLEDGE_BASE_ID=your-knowledge-base-id
ARIA_DATA_SOURCE_ID=your-data-source-id

# AWS Bedrock Model ARNs (Optional - defaults provided)
ARIA_REASONING_MODEL=arn:aws:bedrock:us-east-1:YOUR_ACCOUNT:inference-profile/us.meta.llama3-3-70b-instruct-v1:0
ARIA_MEMORY_MODEL=arn:aws:bedrock:us-east-1:YOUR_ACCOUNT:inference-profile/us.meta.llama3-2-90b-instruct-v1:0

# Aria Behavior Configuration (Optional)
ARIA_PAUSE_SECONDS=30
ARIA_MIND_LOOP_ENABLED=true
ARIA_MAX_SIGNALS=100

# LLM Parameters (Optional)
ARIA_TEMPERATURE=0.5
ARIA_TOP_P=0.9
ARIA_MAX_GEN_LEN=2048

# Server Configuration (Optional)
ARIA_HOST=0.0.0.0
ARIA_PORT=8000
ARIA_RELOAD=true
ARIA_LOG_LEVEL=info